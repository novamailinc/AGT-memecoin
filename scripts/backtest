#!/usr/bin/env bash
# backtest — replay recorded launch histories through entry/exit rules.
#
# Usage:
#   scripts/backtest [dataset] [--min-safety N] [--tp 2:0.5,5:0.25]
#                    [--trailing N] [--time-stop-h N]
#
# Paper only, no network. With no recorded dataset yet it prints a note
# and exits 0 — the recorder builds the dataset from live paper flow.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"
# Interpreter resolution (relocatable; mirrors scripts/supervisor _venv_python):
# FOREX_VENV_PYTHON, else {repo}/.venv, else {repo}/../.venv, else python3.
PY="${FOREX_VENV_PYTHON:-}"
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
    PY=""
    for _c in "$REPO/.venv/bin/python" "$REPO/../.venv/bin/python"; do
        if [ -x "$_c" ]; then PY="$_c"; break; fi
    done
    PY="${PY:-python3}"
fi
exec "$PY" \
    daemon/launch_scanner/backtest.py "$@"
