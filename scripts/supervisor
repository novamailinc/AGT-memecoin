#!/usr/bin/env python3
"""Resident realtime supervisor (2026-10-21, user directive: "a high
end extreme realtime monitoring watchdog, not a timed or scheduled
watchdog").

Replaces the 5-minute cron watchdog as the daemons' keeper. This is a
RESIDENT process: it owns or adopts every bot daemon, notices a death
within ~1 second (owned children are reaped via poll each tick; adopted
processes are checked against /proc), and restarts it immediately under
a per-daemon backoff ladder with a storm guard (a crash-looping daemon
is held, not respawned forever). The old forex-watchdog cron keeps
exactly one job: reviving THIS supervisor after a VM reboot — the
supervisor then restores everything else in seconds.

Design rules:
  * Children are spawned detached (start_new_session) and are NEVER
    killed by the supervisor's own exit — if the supervisor dies, the
    daemons keep running and the next supervisor adopts them.
  * Adoption is verified against /proc/<pid>/cmdline tokens, never a
    bare pattern match (a shell whose command line merely mentions a
    daemon is not the daemon).
  * Single instance, enforced by an flock; a second supervisor exits.
  * State is written every tick to ~/.forex-agent/supervisor_state.json
    (atomic) — that file's timestamp is the supervisor's heartbeat.
  * The supervisor restarts processes. It never edits code, ledgers,
    killswitch state, or any daemon's data — repairs stay with the
    agent under the self-repair protocol.

Paper only — same boundary as everything it guards.
"""
import fcntl
import json
import logging
import os
import signal
import subprocess
import sys
import time

logging.basicConfig(level=logging.WARNING,
                    format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("supervisor")

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HOME = os.environ.get("FOREX_AGENT_HOME", "/home/hatch/.forex-agent")
LOG_DIR = os.path.join(HOME, "log")
STATE_PATH = os.path.join(HOME, "supervisor_state.json")
LOCK_PATH = os.path.join(HOME, "supervisor.lock")

# /proc location, overridable for tests. The supervisor adopts live
# daemons by scanning process command lines; pointing it at a
# scratch proc dir is how the spawn path is proven without ever
# adopting a live daemon (see tests/test_agt_packaging.py).
PROC_DIR = os.environ.get("FOREX_SUPERVISOR_PROC_DIR", "/proc")


def _venv_python():
    """Python that carries the compiled deps (solders for signing).

    Relocatable (Phase 13 finalize): the roster used to hardcode
    the VM path /home/hatch/workspace/Forex-agent/.venv/bin/python,
    which fails on AGT. Resolution order: explicit
    FOREX_VENV_PYTHON env override, else {repo}/.venv/bin/python,
    else {repo}/../.venv/bin/python (the VM layout, where the
    venv is a sibling of the checkout), else the interpreter
    running this supervisor (on AGT, the prefix python). The last
    resort lacks solders unless the prefix provides it —
    devnet-demo-trader then fails at import, loudly, rather
    than silently running unsigned.
    """
    override = os.environ.get("FOREX_VENV_PYTHON")
    if override and os.path.isfile(override) and os.access(override,
                                                           os.X_OK):
        return override
    for cand in (os.path.join(ROOT, ".venv", "bin", "python"),
                 os.path.join(os.path.dirname(ROOT), ".venv", "bin",
                              "python")):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return sys.executable

TICK_S = 1.0
BACKOFF_LADDER = (1.0, 2.0, 5.0, 15.0, 60.0)   # seconds, capped at last
STABLE_S = 600.0        # a run this long resets the ladder
STORM_MAX_STARTS = 6    # starts within STORM_WINDOW_S ...
STORM_WINDOW_S = 600.0
STORM_HOLD_S = 300.0    # ... trigger a hold this long


class Spec:
    def __init__(self, name, argv, token):
        self.name = name
        self.argv = argv
        self.token = token  # cmdline token that identifies the process

    @property
    def log_path(self):
        return os.path.join(LOG_DIR, self.name + ".log")


def _module(name):
    return Spec(name, ["python3", "-m", "daemon." + name],
                "daemon." + name)


def _script(name):
    return Spec(name, ["python3", "scripts/" + name], "scripts/" + name)


