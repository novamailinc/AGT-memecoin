# ---- restart policy (pure logic; unit-tested) ---------------------------

class RestartPolicy:
    """Backoff ladder + storm guard for one daemon."""

    def __init__(self):
        self.starts = []          # start timestamps (windowed)
        self.ladder_idx = 0
        self.hold_until = 0.0

    def note_start(self, now):
        self.starts = [t for t in self.starts
                       if now - t < STORM_WINDOW_S]
        self.starts.append(now)
        if len(self.starts) >= STORM_MAX_STARTS:
            self.hold_until = now + STORM_HOLD_S

    def note_stable(self):
        """A long healthy run resets the ladder and the storm window."""
        self.ladder_idx = 0
        self.starts = []

    def delay(self):
        d = BACKOFF_LADDER[min(self.ladder_idx, len(BACKOFF_LADDER) - 1)]
        self.ladder_idx = min(self.ladder_idx + 1, len(BACKOFF_LADDER) - 1)
        return d

    def allowed(self, now):
        return now >= self.hold_until

    def in_hold(self, now):
        return now < self.hold_until


# ---- process table --------------------------------------------------------

def _cmdline(pid, proc_dir=None):
    try:
        with open(os.path.join(proc_dir or PROC_DIR,
                               "%d/cmdline" % pid),
                  "rb") as f:
            return f.read().replace(b"\0", b" ").decode("utf-8",
                                                        "replace")
    except Exception:
        return ""


def _is_python_cmd(cmd):
    """True for a real interpreter command line: system python3 or a
    venv bin/python. False for shells that merely mention a daemon."""
    return "python3" in cmd or "/bin/python" in cmd


def find_running(token, proc_dir=None):
    """Pids whose cmdline contains the token AND a python interpreter.

    Token match alone would adopt shells that merely mention the
    daemon. The interpreter check must accept the venv binary
    (…/.venv/bin/python) as well as system python3: devnet-demo-trader
    runs under the venv, and the old python3-only check meant the
    supervisor could never adopt it — every supervisor restart
    spawned a duplicate while the orphan kept running (orphans 1945,
    1845, 1857, all 2026-10-30). proc_dir defaults to
    FOREX_SUPERVISOR_PROC_DIR (or /proc); tests point it at a
    scratch dir so a test supervisor never adopts a live daemon."""
    out = []
    for pid_s in os.listdir(proc_dir or PROC_DIR):
        if not pid_s.isdigit():
            continue
        pid = int(pid_s)
        if pid == os.getpid():
            continue
        cmd = _cmdline(pid, proc_dir)
        if token in cmd and _is_python_cmd(cmd):
            out.append(pid)
    return sorted(out)


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


# ---- daemon runtime ---------------------------------------------------------

class Daemon:
    def __init__(self, spec):
        self.spec = spec
        self.policy = RestartPolicy()
        self.proc = None          # Popen when owned
        self.pid = 0
        self.owned = False
        self.state = "init"       # running|backoff|storm-hold|adopted
        self.started_at = None    # None = not started (0.0 is falsy!)
        self.restart_at = 0.0
        self.restarts = 0
        self.last_exit = None
        self.storm_alerted = False

    def spawn(self, now):
        os.makedirs(LOG_DIR, exist_ok=True)
        logf = open(self.spec.log_path, "ab")
        env = dict(os.environ)
        env["FOREX_AGENT_HOME"] = HOME
        self.proc = subprocess.Popen(
            self.spec.argv, cwd=ROOT, env=env,
            stdout=logf, stderr=subprocess.STDOUT,
            start_new_session=True)
        self.pid = self.proc.pid
        self.owned = True
        self.started_at = now
        self.state = "running"
        self.policy.note_start(now)
        logger.warning("supervisor: started %s (pid %d)",
                       self.spec.name, self.pid)

    def adopt(self, pid, now):
        self.pid = pid
        self.owned = False
        self.started_at = now
        self.state = "adopted"
        logger.warning("supervisor: adopted %s (pid %d)",
                       self.spec.name, pid)

    def on_death(self, now, rc):
        uptime = (now - self.started_at
                  if self.started_at is not None else 0.0)
        self.last_exit = rc
        self.proc = None
        self.pid = 0
        self.owned = False
        self.restarts += 1
        if uptime >= STABLE_S:
            self.policy.note_stable()
        if self.policy.in_hold(now):
            self.state = "storm-hold"
            if not self.storm_alerted:
                self.storm_alerted = True
                logger.warning(
                    "supervisor: STORM HOLD %s — %d starts in window; "
                    "holding %.0fs (exit %s)",
                    self.spec.name, len(self.policy.starts),
                    STORM_HOLD_S, rc)
            self.restart_at = self.policy.hold_until
            return
        d = self.policy.delay()
        self.state = "backoff"
        self.restart_at = now + d
        logger.warning(
            "supervisor: %s died (exit %s, uptime %.0fs) — restart in "
            "%.0fs", self.spec.name, rc, uptime, d)

    def tick(self, now):
        if self.state in ("running", "adopted"):
            alive = False
            if self.owned and self.proc is not None:
                rc = self.proc.poll()
                if rc is None:
                    alive = True
                else:
                    self.on_death(now, rc)
                    return
            else:
                alive = pid_alive(self.pid) and \
                    self.spec.token in _cmdline(self.pid)
                if not alive:
                    self.on_death(now, "gone")
                    return
            if alive and self.started_at and \
                    now - self.started_at >= STABLE_S:
                self.policy.note_stable()
            return
        if self.state in ("backoff", "storm-hold", "init"):
            if self.policy.allowed(now) and now >= self.restart_at:
                self.storm_alerted = False
                # Adopt-before-spawn (2026-10-31): a matching process
                # may have appeared since death (watchdog/manual start,
                # or a pre-existing duplicate). Adopt it instead of
                # spawning a second instance that would fight over the
                # same state; without this, a spawn against a live
                # lock-holder would exit at once and loop into storm
                # hold. Adoption is already this supervisor's core
                # mechanism; this applies it at respawn time too.
                pids = find_running(self.spec.token)
                if pids:
                    self.adopt(pids[0], now)
                else:
                    self.spawn(now)


# ---- supervisor -------------------------------------------------------------

class Supervisor:
    def __init__(self, roster=ROSTER):
        self.daemons = {s.name: Daemon(s) for s in roster}
        self.stop = False

    def adopt_existing(self, now):
        for d in self.daemons.values():
            pids = find_running(d.spec.token)
            if pids:
                d.adopt(pids[0], now)
            else:
                d.state = "init"
                d.restart_at = now  # spawn on first tick

    def tick(self, now):
        for d in self.daemons.values():
            try:
                d.tick(now)
            except Exception:
                logger.exception("supervisor: tick failed for %s",
                                 d.spec.name)

    def state_dict(self, now):
        return {
            "ts": now,
            "pid": os.getpid(),
            "daemons": {
                name: {
                    "state": d.state,
                    "pid": d.pid,
                    "owned": d.owned,
                    "restarts": d.restarts,
                    "last_exit": d.last_exit,
                    "uptime_s": (round(now - d.started_at, 1)
                                 if d.pid and d.started_at else 0),
                } for name, d in self.daemons.items()
            },
        }

    def write_state(self, now):
        try:
            tmp = STATE_PATH + ".tmp"
            with open(tmp, "w") as f:
                json.dump(self.state_dict(now), f, separators=(",", ":"))
            os.replace(tmp, STATE_PATH)
        except Exception:
            logger.exception("supervisor: state write failed")


def _active_roster():
    """The roster the supervisor actually runs. Normally all 28.
    FOREX_SUPERVISOR_ONLY (comma-separated daemon names) restricts
    it — test/validation ONLY (proving the spawn path with one
    daemon in a scratch home without adopting the live fleet).
    Never set it in production: a restricted supervisor would
    leave the rest of the fleet unguarded."""
    if '--telegram-control-only' in sys.argv:
        os.environ['TELEGRAM_CONTROL_ONLY']='1'
        return [Spec('telegram', [sys.executable,'-m','daemon.telegram','--control-only'],
                     'daemon.telegram')]
    only = os.environ.get("FOREX_SUPERVISOR_ONLY")
    if not only:
        return list(ROSTER)
    wanted = {n.strip() for n in only.split(",") if n.strip()}
    return [s for s in ROSTER if s.name in wanted]


def main():
    os.makedirs(HOME, exist_ok=True)
    lockf = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        logger.warning("supervisor: another instance holds the lock; "
                       "exiting")
        return 1
    sup = Supervisor(roster=_active_roster())

    def _term(signum, frame):
        sup.stop = True

    signal.signal(signal.SIGTERM, _term)
    signal.signal(signal.SIGINT, _term)
    now = time.time()
    sup.adopt_existing(now)
    running = sum(1 for d in sup.daemons.values()
                  if d.state in ("running", "adopted"))
    logger.warning("supervisor started (pid %d): %d/%d daemons present, "
                   "spawning the rest", os.getpid(), running,
                   len(sup.daemons))
    while not sup.stop:
        t0 = time.time()
        sup.tick(t0)
        sup.write_state(t0)
        time.sleep(max(0.1, TICK_S - (time.time() - t0)))
    logger.warning("supervisor stopping (children keep running)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
