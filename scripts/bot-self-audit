AUDIT_LOG = os.path.join(HOME, "self_audit.jsonl")
LOG_DIR = os.path.join(HOME, "log")
BACKUP_DIR = os.path.join(HOME, "backups")
RUN_DIR = os.path.join(HOME, "run")
BUS_PATH = os.path.join(HOME, "launch_scanner", "signal_bus.jsonl")
HEARTBEAT_PATH = os.path.join(RUN_DIR, "heartbeat.json")
# Realtime beats (2026-10-23): watcher-trader + realtime-sync beat
# into run/heartbeat.json every 2s. 30s = 15 missed beats — beyond
# that the emitter is dead/wedged, not jittering.
HEARTBEAT_STALE_S = 30
HEARTBEAT_SOURCES = ("realtime-sync", "watcher-trader")
SPARK_SEEN_PATH = os.path.join(HOME, "spark_seen.json")
KILLSWITCH_STATE = os.path.join(HOME, "killswitch", "state.json")
DECOMMISSIONED_NAME = "decommissioned.json"

BACKUP_MAX_AGE_S = 2.5 * 3600
DISK_MIN_FREE = 1 * 1024 ** 3
