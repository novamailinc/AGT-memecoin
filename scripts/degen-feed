# Tuning knobs — loaded from degen-weights.json, auto-tuned by degen-learner
WEIGHTS_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                            "degen-weights.json")
_weights_cache = {}
_weights_mtime = 0


def get_weights():
    global _weights_cache, _weights_mtime
    try:
        mtime = os.path.getmtime(WEIGHTS_FILE)
        if mtime != _weights_mtime:
            with open(WEIGHTS_FILE) as f:
                _weights_cache = json.load(f)
            _weights_mtime = mtime
    except Exception:
        pass
    w = _weights_cache.get("weights", {})
    t = _weights_cache.get("thresholds", {})
    return {
        "w_freshness": w.get("freshness", 1.0),
        "w_buy_pressure": w.get("buy_pressure", 1.0),
        "w_buyer_count": w.get("buyer_count", 1.0),
        "w_momentum": w.get("momentum", 1.0),
        "w_fdv_zone": w.get("fdv_zone", 1.0),
        # 2026-10-20: smart money is WATCHLIST-ONLY (user decision;
        # copy-trading measured -41% avg, follower grades 0 active).
        # The weights file stores smart_money_bonus as an ABSOLUTE
        # value (currently 25.0) that the nightly learner's file
        # round-trip preserves, so the applied bonus is clamped to 0
        # HERE in code — a stored value can never resurrect it. The
        # 🧠 hit is still detected, reasoned and journaled; it just
        # scores 0. Re-enable only on follower-grade evidence.
        "sm_bonus": 0.0,
        "min_score": t.get("min_score", 45),
        "min_fdv": t.get("min_fdv", 8000.0),
        "max_fdv": t.get("max_fdv", 600000.0),
        "min_reserve": t.get("min_reserve", 4000.0),
        "min_buyers_m5": t.get("min_buyers_m5", 3),
        "min_buy_sell_ratio": t.get("min_buy_sell_ratio", 0.8),
        "max_age_minutes": t.get("max_age_minutes", 15),
    }


# Defaults for initial scoring (overridden by get_weights at runtime)
MIN_SCORE = 45
