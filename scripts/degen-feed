                    format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("degen-feed")

HOME = (os.environ.get("FOREX_AGENT_HOME") or os.path.expanduser("~/.forex-agent"))
SEEN_FILE = os.path.join(HOME, "degen_seen.json")
TRACK_FILE = os.path.join(HOME, "degen_outcomes.json")
LS_DIR = os.path.join(HOME, "launch_scanner")

# Counterfactual candidate log (2026-10-23, signal audit §6.4): alert-time
# features for ALL scored candidates — fired, sub-threshold, hard-filter
# rejects, safety blocks — not just fired cards. Without the rejects the
# learner can never judge whether the filters/min_score chose well.
# Bounded JSONL: rotated down to CANDIDATES_KEEP lines past the byte cap.
CANDIDATES_FILE = os.path.join(HOME, "degen_candidates.jsonl")
CANDIDATES_MAX_BYTES = 2_000_000
CANDIDATES_KEEP = 1000

