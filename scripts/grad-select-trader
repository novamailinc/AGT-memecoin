#!/usr/bin/env python3
"""Graduation SELECT trader daemon (2026-10-24, user-ordered).

Runs the graduation SELECT lane (daemon/launch_scanner/
grad_select.py): grad_raw's every-graduation spray filtered ONLY
by the externally-evidenced selection rules — serial deployers
(>= 3 launches/24h rejected), fast curve through few trades
(TTG <= 1h and <= 250 curve signatures), canonical pools only,
copycat tickers (>= 3 other same-ticker launches/24h rejected).
NO safety gate, NO veto — by design: grad_raw is the no-filter
control, the gated grad lane is the safety comparison.

Detection: live PumpPortal migration WebSocket + GeckoTerminal
newest-pools backfill every ~60s over a 30-minute window,
FIRE-FIRST migration-tx payload pricing (grad_raw's machinery).
Exits are evaluated in this same loop (~5s cycle) and by the
armed watcher on push prices.

Pre-registered verdict: at 100 closes, expectancy <= 0 halts the
lane permanently (killswitch lane "grad_select", human-only
re-enable); reported raw + ex-top-1 + head-to-head vs grad_raw.

Paper only. Telegram confirmation cards at 2x (user-ordered
2026-10-28); everything else journal/ledger only. Nothing here
touches real money, keys, or the user's lanes. Free-only:
PumpPortal stream + GeckoTerminal + DexScreener + Helius RPC.
"""
import logging
import os
import sys as _sys
import threading
import time

logging.basicConfig(level=logging.WARNING,
                    format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("grad-select-trader")

_HERE = os.path.dirname(os.path.abspath(__file__))
_sys.path.insert(0, os.path.join(_HERE, "..", "daemon", "launch_scanner"))
_sys.path.insert(0, os.path.join(_HERE, ".."))
try:
    import grad_select as _sel
    import pumpportal as _pp
    import killswitch as _ks_check
    import armed_watch as _aw
    import dossiers as _dossiers
    import rt_sync as _rt
    import heartbeat as _hb
    _HAS_DEPS = True
except ImportError as e:
    _HAS_DEPS = False
    _IMPORT_ERROR = e

# P4 event recorder: fail-soft — a missing recorder never stops
# the lane.
try:
    import recorder as _recorder
except Exception:
    try:
        from daemon.launch_scanner import recorder as _recorder
    except Exception:
        _recorder = None

# R1/R2 (flag-off source): cycle journal + entry gate for the main loop. Fail-soft import: a missing module leaves the old loop untouched.
try:
    from daemon import grad_trader_cycle as _gtc
except Exception:
    _gtc = None
_FLAG_ON = os.environ.get("AGT_GRAD_CYCLE_ENABLED") == "1"

POLL_SECS = 5
GT_BACKFILL_EVERY_S = 60
GT_BACKFILL_PAGES = 5


def _heartbeat_loop():
    """Emit the grad-select-trader heartbeat on an independent
    2-second thread (filter evaluation can block the trading loop
    on RPC round-trips; the cadence proof must not depend on it)."""
    while True:
        try:
            _hb.beat("grad-select-trader")
        except Exception:
            pass
        time.sleep(_hb.BEAT_INTERVAL_S)


def main():
    import os as _os
    import sys as _sys
    _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), ".."))
    from daemon.common import guard_singleton
    guard_singleton("grad-select-trader", token="scripts/grad-select-trader")
    if not _HAS_DEPS:
        logger.warning("grad-select deps missing: %s", _IMPORT_ERROR)
        return 1
    engine = _sel.make_engine()
    state = engine.ensure_ledger()
    # Materialize the killswitch lane entry (not halted) so the
    # lane is visible in killswitch status from day one.
    try:
        _ks_check.check_lane(_sel.LANE)
    except Exception:
        pass
    # Trial registry + verdict-ledger seed checkpoint (fail-soft,
    # idempotent).
    try:
        _sel.register_trial()
        _sel.seed_checkpoint(engine)
    except Exception:
        pass
    threading.Thread(target=_heartbeat_loop, name="grad-select-heartbeat",
                     daemon=True).start()
    feed = _pp.PumpPortalFeed()
    feed.start()

    # Armed positions (peak >= 1.5x) are priced by PUSH, exactly
    # as in the grad-raw daemon; the loop's poll is the backstop.
    def _armed_price_fn(chain, mint, spot_index=None):
        wp = watcher.price(mint)
        if wp > 0:
            return wp
        return engine.quote_price(chain, mint, spot_index)

    def _on_armed_price(mint, px, ts):
        try:
            engine.poll_exits(_armed_price_fn)
        except Exception:
            pass

    def _on_watch_state(state, info):
        logger.warning("grad-select armed watch: %s %s", state, info)
        if state == "RECONCILED":
            for mv in (info or {}).get("moved") or []:
                rec = dict(mv)
                rec["ts"] = time.time()
                rec["source"] = "grad-select-armed-watch"
                _rt.journal_reconciliation(rec)

    watcher = _aw.ArmedWatcher(on_price=_on_armed_price,
                               on_state=_on_watch_state)
    watcher.start()

    # FASTER EXITS (2026-11-20, item 1b): dedicated exit-poll thread.
    # The main loop below still polls (backstop); this thread polls
    # every ~10s while any position is <15 min old, so a slow scan
    # can no longer delay exits. Latency-only: the same poll_exits
    # with the same price_fn — same decisions, same pricing, inside
    # the pacer. Fail-soft: a missing helper leaves the previous
    # cadence byte-identical.
    try:
        import exit_cadence as _ec
    except Exception:
        _ec = None
    if _ec is not None:
        _exit_poller = _ec.ExitPoller(
            poll_fn=lambda: engine.poll_exits(_armed_price_fn),
            positions_fn=engine.open_positions,
            on_error=lambda e: logger.warning(
                "grad-select exit poller: %s", e))
        _exit_poller.start()

    def _observe(items):
        # P8: births open dossiers; migrations stamp them.
        _dossiers.observe_births(items)
        _dossiers.observe_migrations(items)
        # Select filters: fold births/migrations into the local
        # index at once (the recorder files catch up behind it).
        _sel.note_items(items)
        # P4: record births + migrations for offline replay.
        if _recorder is not None:
            for item in items or []:
                try:
                    src = (item or {}).get("source")
                    if src == "pumpportal-new":
                        kind = "birth"
                    elif src == "pumpportal-migration":
                        kind = "migration"
                    else:
                        continue
                    body = dict(item)
                    body.setdefault("lane", _sel.LANE)
                    _recorder.record(kind, body)
                except Exception:
                    continue

    # FIRE-FIRST entry thread: wake on stream arrival and run a
    # fresh-only scan (filters evaluated inline for this cycle's
    # candidates, then payload-priced entries). Watchlist retries
    # and the GT backfill stay in the main loop.
    def _entry_loop():
        while True:
            try:
                q = getattr(feed, "_q", None)
                if q is not None and not q.empty():
                    def _fresh():
                        return _sel.scan_once(
                            engine, feed=feed, gt_rows=None,
                            on_items=_observe, fresh_only=True)
                    if _gtc is None:
                        if _FLAG_ON:
                            # flag on but the wiring module is missing:
                            # NEVER scan ungated (fail closed).
                            logger.warning("grad-select entries refused: "
                                           "cycle flag on, wiring missing")
                            time.sleep(1.0)
                            continue
                        _fresh()
                    else:
                        _ran, _why, _r = _gtc.entry_scan(engine, _fresh)
                        if not _ran:
                            logger.warning("grad-select entry scan "
                                           "skipped: %s", _why)
                            time.sleep(0.2)
                else:
                    time.sleep(0.1)
            except Exception:
                logger.exception("grad-select entry loop failed")
                time.sleep(1.0)

    threading.Thread(target=_entry_loop, name="grad-select-entry",
                     daemon=True).start()

    logger.warning("grad-select-trader started (paper only, NO safety "
                   "gate, evidence filters ON, bankroll $%.2f, state "
                   "%s, verdict sample %d closes)",
                   float(state.get("bankroll") or 0), state.get("state"),
                   _sel.VERDICT_SAMPLE_CLOSES)
    if _gtc is not None:
        _gtc.register(engine)
        logger.warning("grad-select cycle wiring: %s",
                       _gtc.startup_report(engine))
    last_gt = 0.0
    while True:
        try:
            gt_rows = None
            now = time.time()
            if now - last_gt >= GT_BACKFILL_EVERY_S:
                last_gt = now
                gt_rows = engine.fetch_candidates(GT_BACKFILL_PAGES)
            def _legacy():
                # ORIGINAL order, used whenever the cycle wiring is off.
                r = _sel.scan_once(engine, feed=feed, gt_rows=gt_rows,
                                   on_items=_observe)
                # Time-only exit FIRST: the 24h stop fires on the last
                # known price with no price read at all, so it works
                # even when every pricing source is down.
                c = engine.poll_time_exits() + engine.poll_exits(
                    _armed_price_fn)
                return r, len(c)
            if _gtc is None and _FLAG_ON:
                # flag on, wiring missing: exits only, no entries.
                logger.warning("grad-select entries refused: cycle flag "
                               "on, wiring missing")
                n_closes = len(engine.poll_time_exits()
                               + engine.poll_exits(_armed_price_fn))
                res = {"stream": 0, "opened": 0, "select_rejected": 0,
                       "select_reasons": {}}
            elif _gtc is None:
                res, n_closes = _legacy()
            else:
                res, n_closes, _rec = _gtc.main_cycle(
                    engine, _armed_price_fn,
                    lambda: _sel.scan_once(engine, feed=feed,
                                           gt_rows=gt_rows,
                                           on_items=_observe),
                    _legacy)
            try:
                _sel.maybe_confirmation_cards(engine)
            except Exception:
                logger.exception("grad-select confirmation cards failed")
            try:
                _sel.maybe_entry_cards(engine)
            except Exception:
                logger.exception("grad-select entry cards failed")
            watcher.set_positions(
                _aw.armed_positions(engine.open_positions()))
            _sel.maybe_verdict_report(engine)
            if res.get("opened") or n_closes or \
                    res.get("select_rejected"):
                st = engine.account_state()
                logger.warning(
                    "grad-select-trader: %d stream, %d opened, %d "
                    "filter-rejected %s; %d closes; cash $%.2f, "
                    "%d open, state %s",
                    res.get("stream", 0), res.get("opened", 0),
                    res.get("select_rejected", 0),
                    res.get("select_reasons") or {},
                    n_closes, st.get("bankroll", 0.0),
                    st.get("n_open", 0), st.get("state"))
        except Exception:
            logger.exception("grad-select-trader loop failed")
        time.sleep(POLL_SECS)


if __name__ == "__main__":
    raise SystemExit(main())
