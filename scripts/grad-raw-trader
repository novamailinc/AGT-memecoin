#!/usr/bin/env python3
"""Graduation RAW trader daemon (2026-10-23, user-ordered).

Runs the graduation RAW lane (daemon/launch_scanner/grad_raw.py):
grad_select's four evidence filters on entries (2026-11-10 filter
port, user-ordered — before that date this lane bought EVERY
graduation unfiltered), NO safety gate, $25 paper shots, the
user's exit ladder, $100 paper bankroll, NO daily cap (the
bankroll is the limit).

Detection: a live PumpPortal migration WebSocket (graduations the
second they happen — the gated lane lost KWH to GeckoTerminal's
~10-minute indexing lag) plus a GeckoTerminal newest-pools backfill
every ~60s over a 30-minute window for stream gaps. Exits are
evaluated in this same loop (~5s cycle).

FIRE-FIRST (2026-10-23): a dedicated entry thread wakes the moment
the migration stream delivers, so stream entries no longer wait
behind this loop's exit polling (measured drain wait: median 83s).
Entries it makes are priced from the migration transaction itself
(grad_raw's FIRE-FIRST path); watchlist retries and the GT backfill
stay in this main loop at its normal cadence.

Pre-registered verdict: at 100 closes, expectancy <= 0 halts the
lane permanently (killswitch lane "grad_raw", human-only re-enable).

Paper only. NO Telegram cards — journal/ledger only, like the gated
lane. Nothing here touches real money, keys, or the user's lanes.
Free-only: PumpPortal public stream + GeckoTerminal + DexScreener.
"""
import logging
import os
import sys as _sys
import threading
import time

logging.basicConfig(level=logging.WARNING,
                    format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("grad-raw-trader")

_HERE = os.path.dirname(os.path.abspath(__file__))
_sys.path.insert(0, os.path.join(_HERE, "..", "daemon", "launch_scanner"))
_sys.path.insert(0, os.path.join(_HERE, ".."))
try:
    import grad_raw as _raw
    import pumpportal as _pp
    import killswitch as _ks_check
    import armed_watch as _aw
    import dossiers as _dossiers
    import rt_sync as _rt
    _HAS_DEPS = True
except ImportError as e:
    _HAS_DEPS = False
    _IMPORT_ERROR = e

# P4 event recorder: fail-soft, like grad.py's reserves import —
# a missing recorder never stops the lane.
try:
    import recorder as _recorder
except Exception:
    try:
        from daemon.launch_scanner import recorder as _recorder
    except Exception:
        _recorder = None

# Cycle-hook registration only (write-ahead marker, abort hook, entry refusal). Fail-soft import; the raw lane has no cycle journal or entry-scan wiring here.
try:
    from daemon import grad_trader_cycle as _gtc
except Exception:
    _gtc = None
_FLAG_ON = os.environ.get("AGT_GRAD_CYCLE_ENABLED") == "1"

POLL_SECS = 5
GT_BACKFILL_EVERY_S = 60
GT_BACKFILL_PAGES = 5


def main():
    import os as _os
    import sys as _sys
    _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), ".."))
    from daemon.common import guard_singleton
    guard_singleton("grad-raw-trader", token="scripts/grad-raw-trader")
    if not _HAS_DEPS:
        logger.warning("grad-raw deps missing: %s", _IMPORT_ERROR)
        return 1
    engine = _raw.make_engine()
    state = engine.ensure_ledger()
    # BEFORE any thread (feed, armed watcher, exit poller, entry loop) can call poll_exits; no ledger I/O. No-op unless AGT_GRAD_CYCLE_ENABLED=1.
    if _gtc is not None:
        if not _gtc.register(engine):
            logger.error("grad-raw cycle hook registration FAILED: entries are refused while AGT_GRAD_CYCLE_ENABLED=1 (exits continue)")
        logger.warning("grad-raw cycle wiring: %s", _gtc.startup_report(engine))
    elif _FLAG_ON:
        logger.error("grad-raw cycle flag on but grad_trader_cycle could not be imported: NO ENTRIES (exits only)")
    # Materialize the killswitch lane entry (not halted) so the lane
    # is visible in killswitch status from day one.
    try:
        _ks_check.check_lane(_raw.LANE)
    except Exception:
        pass
    feed = _pp.PumpPortalFeed()
    feed.start()

    # P1/P9a: armed positions (peak >= 1.5x) are priced by PUSH —
    # accountSubscribe on their pool vaults; every swap re-prices
    # and re-evaluates exits on the event, not the 5s clock. The
    # loop's own poll remains as backstop with the same price_fn.
    def _armed_price_fn(chain, mint, spot_index=None):
        wp = watcher.price(mint)
        if wp > 0:
            return wp
        return engine.quote_price(chain, mint, spot_index)

    def _on_armed_price(mint, px, ts):
        try:
            engine.poll_exits(_armed_price_fn)
        except Exception:
            pass

    def _on_watch_state(state, info):
        logger.warning("grad-raw armed watch: %s %s", state, info)
        if state == "RECONCILED":
            for mv in (info or {}).get("moved") or []:
                rec = dict(mv)
                rec["ts"] = time.time()
                rec["source"] = "grad-raw-armed-watch"
                _rt.journal_reconciliation(rec)

    watcher = _aw.ArmedWatcher(on_price=_on_armed_price,
                               on_state=_on_watch_state)
    watcher.start()

    # FASTER EXITS (2026-11-20, item 1b): dedicated exit-poll thread.
    # The main loop below still polls (backstop); this thread polls
    # every ~10s while any position is <15 min old, so a slow scan
    # can no longer delay exits. Latency-only: the same poll_exits
    # with the same price_fn — same decisions, same pricing, inside
    # the pacer. Fail-soft: a missing helper leaves the previous
    # cadence byte-identical.
    try:
        import exit_cadence as _ec
    except Exception:
        _ec = None
    if _ec is not None:
        _exit_poller = _ec.ExitPoller(
            poll_fn=lambda: engine.poll_exits(_armed_price_fn),
            positions_fn=engine.open_positions,
            on_error=lambda e: logger.warning(
                "grad-raw exit poller: %s", e))
        _exit_poller.start()

    def _observe(items):
        # P8: births open dossiers; migrations stamp them.
        _dossiers.observe_births(items)
        _dossiers.observe_migrations(items)
        # P4: record births + migrations for offline replay.
        if _recorder is not None:
            for item in items or []:
                try:
                    src = (item or {}).get("source")
                    if src == "pumpportal-new":
                        kind = "birth"
                    elif src == "pumpportal-migration":
                        kind = "migration"
                    else:
                        continue
                    body = dict(item)
                    body.setdefault("lane", _raw.LANE)
                    _recorder.record(kind, body)
                except Exception:
                    continue

    # FIRE-FIRST entry thread: wake on stream arrival and run a
    # fresh-only scan (entries for just-drained migrations, priced
    # from the migration tx). The engine's ledger access is
    # flock-serialized and the armed watcher already calls poll_exits
    # from its own thread, so a second scan thread follows an
    # existing concurrency pattern; dedupe/bankroll/caps are
    # re-checked under the write lock inside consider_candidate.
    def _entry_loop():
        while True:
            try:
                q = getattr(feed, "_q", None)
                if q is not None and not q.empty():
                    def _fresh():
                        return _raw.scan_once(
                            engine, feed=feed, gt_rows=None,
                            on_items=_observe, fresh_only=True)
                    if _gtc is None:
                        if _FLAG_ON:
                            # flag on, wiring module missing: NEVER scan ungated
                            logger.warning("grad-raw entries refused: cycle flag on, wiring missing")
                            time.sleep(1.0)
                            continue
                        _fresh()
                    else:
                        _ran, _why, _r = _gtc.entry_scan(engine, _fresh)
                        if not _ran:
                            logger.warning("grad-raw entry scan skipped: %s", _why)
                            time.sleep(0.2)
                else:
                    time.sleep(0.1)
            except Exception:
                logger.exception("grad-raw entry loop failed")
                time.sleep(1.0)

    threading.Thread(target=_entry_loop, name="grad-raw-entry",
                     daemon=True).start()

    logger.warning("grad-raw-trader started (paper only, NO safety "
                   "gate, bankroll $%.2f, state %s, verdict sample "
                   "%d closes)",
                   float(state.get("bankroll") or 0), state.get("state"),
                   _raw.VERDICT_SAMPLE_CLOSES)
    last_gt = 0.0
    while True:
        try:
            gt_rows = None
            now = time.time()
            if now - last_gt >= GT_BACKFILL_EVERY_S:
                last_gt = now
                gt_rows = engine.fetch_candidates(GT_BACKFILL_PAGES)
            def _legacy():
                # ORIGINAL order (scan, then time-only exit FIRST, then price exits), used whenever the cycle wiring is off.
                r = _raw.scan_once(engine, feed=feed, gt_rows=gt_rows,
                                   on_items=_observe)
                # Time-only exit FIRST: the 24h stop fires on the last
                # known price with no price read at all, so it works
                # even when every pricing source is down.
                c = engine.poll_time_exits() + engine.poll_exits(_armed_price_fn)
                return r, len(c)
            if _gtc is None and _FLAG_ON:
                # flag on, wiring missing: exits only, no entries.
                logger.warning("grad-raw entries refused: cycle flag on, wiring missing")
                closes = (engine.poll_time_exits()
                          + engine.poll_exits(_armed_price_fn))
                res = {"stream": 0, "opened": 0}
                n_closes = len(closes)
            elif _gtc is None:
                res, n_closes = _legacy()
            else:
                # EXITS FIRST when the flag is on (main_cycle); flag off: _legacy, the original order.
                res, n_closes, _rec = _gtc.main_cycle(
                    engine, _armed_price_fn,
                    lambda: _raw.scan_once(engine, feed=feed,
                                           gt_rows=gt_rows,
                                           on_items=_observe),
                    _legacy)
            try:
                _raw.maybe_confirmation_cards(engine)
            except Exception:
                logger.exception("grad-raw confirmation cards failed")
            watcher.set_positions(
                _aw.armed_positions(engine.open_positions()))
            if res.get("opened") or n_closes:
                st = engine.account_state()
                logger.warning(
                    "grad-raw-trader: %d stream, %d opened; %d closes; "
                    "cash $%.2f, %d open, state %s",
                    res.get("stream", 0), res.get("opened", 0),
                    n_closes, st.get("bankroll", 0.0),
                    st.get("n_open", 0), st.get("state"))
        except Exception:
            logger.exception("grad-raw-trader loop failed")
        time.sleep(POLL_SECS)


if __name__ == "__main__":
    raise SystemExit(main())
