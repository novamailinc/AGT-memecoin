#!/usr/bin/env python3
"""Paper-mirror exit engine daemon (2026-10-17).

Polls all open degen-card paper mirror positions every 120s and runs
the pre-registered exit plan: the user's ladder (50% @ 2x, 25% @ 3x,
25% on 30% trailing stop, -50% hard stop, 24h time stop), with honest
per-chain costs on every leg.

Paper only. Nothing here trades, sends cards, or touches the user's
lane. A halted mirror lane stops new entries; this daemon keeps
managing already-open positions to their planned exits.

Free-only: stdlib HTTP (DexScreener, Hyperliquid public APIs).
"""
import logging
import os
import sys as _sys
import time

logging.basicConfig(level=logging.WARNING,
                    format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("mirror-exits")

_sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                               "..", "daemon", "launch_scanner"))
try:
    import mirror as _mirror
    _HAS_MIRROR = True
except ImportError as e:
    _HAS_MIRROR = False
    _IMPORT_ERROR = e

POLL_SECS = 120


def main():
    import os as _os
    import sys as _sys
    _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), ".."))
    from daemon.common import guard_singleton
    guard_singleton("mirror-exits", token="scripts/mirror-exits")
    if not _HAS_MIRROR:
        logger.warning("mirror module missing: %s", _IMPORT_ERROR)
        return 1
    logger.warning("mirror-exits started (paper only)")
    while True:
        try:
            n_open = len(_mirror.open_positions())
            closes = _mirror.poll_exits()
            if closes:
                logger.warning("mirror-exits: %d closes (%d still open)",
                               len(closes), n_open - len(closes))
        except Exception:
            logger.exception("mirror-exits loop failed")
        time.sleep(POLL_SECS)


if __name__ == "__main__":
    raise SystemExit(main())
