#!/usr/bin/env python3
"""Verify the tamper-evident verdict ledger chain.

Usage:
    scripts/verify-verdict-ledger [--path <events.jsonl>]

Prints the chain file, record count, head hash, and OK / BROKEN at
seq N. Exit code 0 when the chain verifies, 1 when broken.
Read-only: never writes the chain.
"""
import os
import sys as _sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT = os.path.dirname(_HERE)
_sys.path.insert(0, _ROOT)
_sys.path.insert(0, os.path.join(_ROOT, "daemon", "launch_scanner"))

try:
    from daemon.launch_scanner import verdict_ledger as _vl
except Exception:  # script-style import path
    import verdict_ledger as _vl  # type: ignore


def main(argv=None):
    import argparse
    p = argparse.ArgumentParser(
        description="Verify the tamper-evident verdict ledger chain.")
    p.add_argument("--path", default=None,
                   help="chain file (default: $FOREX_AGENT_HOME/"
                        "verdict_ledger/events.jsonl)")
    args = p.parse_args(argv)
    chain_path = _vl.ledger_path(args.path)
    ok, n, bad = _vl.verify(chain_path)
    print("path: %s" % chain_path)
    print("records: %d" % n)
    print("head_hash: %s" % _vl.head_hash(chain_path))
    if ok:
        print("status: OK")
        return 0
    print("status: BROKEN at seq %s" % bad)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
