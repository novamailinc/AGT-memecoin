POLL_SECS = 5  # 2026-10-12 speed pass: GeckoTerminal free tier = 30 req/min;
# 5s polls = ~12 req/min, verified no 429s over a 60s live probe.
# Cycle cost is now dominated by I/O, parallelized below.

# Websocket fast-path: degen-ws-listener appends new pump.fun mints here;
