#!/usr/bin/env python3
"""Graduation test trader daemon (2026-10-21; P2 stream 2026-10-23).

Runs the graduation test lane (daemon/launch_scanner/grad.py):
takes $1 paper shots at pump.fun graduations through the
instant-safety + veto gates, and runs the user's exit ladder on
open positions.

Detection (P2, 2026-10-23): the LIVE PumpPortal migration stream is
the primary source — graduations the second they happen. The gated
lane originally polled GeckoTerminal's newest pools and lost KWH
to GT's ~10-minute indexing lag; GT is now the 60s backfill that
covers stream gaps (reboots), exactly like the raw lane. Entries
stamp their detection source in the ledger. The daemon loop runs
at 5s so stream candidates and watchlist retries move at stream
speed; exits are additionally driven event-style by realtime-sync.

This lane is a MEASUREMENT of the "buy at graduation" strategy with
a pre-registered verdict: at 100 closes, expectancy <= 0 halts it
permanently (killswitch lane "grad", human-only re-enable).

Paper only. NO Telegram cards in v1 — journal/ledger only. Nothing
here touches real money, keys, or the user's lanes.
Free-only: PumpPortal public stream + GeckoTerminal + DexScreener.
"""
import logging
import os
import sys as _sys
import time

logging.basicConfig(level=logging.WARNING,
                    format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("grad-trader")

_HERE = os.path.dirname(os.path.abspath(__file__))
_sys.path.insert(0, os.path.join(_HERE, "..", "daemon", "launch_scanner"))
_sys.path.insert(0, os.path.join(_HERE, ".."))
try:
    import grad as _grad
    import pumpportal as _pp
    import killswitch as _ks_check
    _HAS_GRAD = True
except ImportError as e:
    _HAS_GRAD = False
    _IMPORT_ERROR = e

try:
    from daemon import grad_trader_cycle as _gtc
except Exception:
    _gtc = None
_FLAG_ON = os.environ.get("AGT_GRAD_CYCLE_ENABLED") == "1"

POLL_SECS = 5
GT_BACKFILL_EVERY_S = 60


def main():
    import os as _os
    import sys as _sys
    _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), ".."))
    from daemon.common import guard_singleton
    guard_singleton("grad-trader", token="scripts/grad-trader")
    if not _HAS_GRAD:
        logger.warning("grad module missing: %s", _IMPORT_ERROR)
        return 1
    state = _grad.ensure_ledger()
    # Register BEFORE the loop (no threads here). No-op unless AGT_GRAD_CYCLE_ENABLED=1. A failure is latched in grad_trader_cycle and refuses entries.
    if _gtc is not None:
        if not _gtc.register(_grad):
            logger.error("grad cycle hook registration FAILED: entries are refused while AGT_GRAD_CYCLE_ENABLED=1 (exits continue)")
        logger.warning("grad cycle wiring: %s", _gtc.startup_report(_grad))
    elif _FLAG_ON:
        logger.error("grad cycle flag on but grad_trader_cycle could not be imported: NO ENTRIES (exits only)")
    # Materialize the killswitch lane entry (not halted) so the lane
    # is visible in killswitch status from day one.
    try:
        _ks_check.check_lane(_grad.LANE)
    except Exception:
        pass
    feed = _pp.PumpPortalFeed()
    feed.start()
    logger.warning("grad-trader started (paper only, bankroll $%.2f, "
                   "state %s, verdict sample %d closes, detection: "
                   "PumpPortal stream + GT backfill)",
                   float(state.get("bankroll") or 0), state.get("state"),
                   _grad.VERDICT_SAMPLE_CLOSES)
    last_gt = 0.0
    while True:
        try:
            now = time.time()
            fetch_gt = now - last_gt >= GT_BACKFILL_EVERY_S
            if fetch_gt:
                last_gt = now
            def _legacy():
                # ORIGINAL order, used whenever the cycle wiring is off.
                r = _grad.scan_once(feed=feed, fetch_gt=fetch_gt)
                # Time-only exit FIRST: the 24h stop fires on the last
                # known price with no price read at all, so it works
                # even when every pricing source is down.
                c = _grad.poll_time_exits() + _grad.poll_exits()
                return r, len(c)
            if _gtc is None and _FLAG_ON:
                logger.warning("grad entries refused: cycle flag on, wiring missing")
                closes = _grad.poll_time_exits() + _grad.poll_exits()
                res, n_closes = {"stream": 0, "pools": 0, "opened": 0}, len(closes)
            elif _gtc is None:
                res, n_closes = _legacy()
            else:
                # EXITS FIRST when the flag is on (main_cycle); flag off: _legacy, the original order. price_fn None = the module's own default pricing, as before.
                res, n_closes, _rec = _gtc.main_cycle(
                    _grad, None,
                    lambda: _grad.scan_once(feed=feed, fetch_gt=fetch_gt),
                    _legacy)
            if res.get("opened") or n_closes:
                st = _grad.account_state()
                logger.warning(
                    "grad-trader: %d stream, %d pools, %d opened; "
                    "%d closes; cash $%.2f, %d open, state %s",
                    res.get("stream", 0), res.get("pools", 0),
                    res.get("opened", 0), n_closes,
                    st.get("bankroll", 0.0), st.get("n_open", 0),
                    st.get("state"))
        except Exception:
            logger.exception("grad-trader loop failed")
        time.sleep(POLL_SECS)


if __name__ == "__main__":
    raise SystemExit(main())
