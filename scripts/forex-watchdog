# roster entry and no cron it stayed dead for 9 days. Primary keeper is
# now the resident supervisor roster; this stanza is the fallback (same
# pattern as the other standalone daemons).
if ! pgrep -f "scripts/degen-peak-tracker" > /dev/null 2>&1; then
    cd "$AGENT_ROOT" || exit 2
    FOREX_AGENT_HOME="$HOME_DIR" nohup python3 scripts/degen-peak-tracker \
        >> "$HOME_DIR/log/degen-peak-tracker.log" 2>&1 &
    echo "$(ts) watchdog: restarted dead degen-peak-tracker" >> "$WLOG"
    after="$after + degen-peak-tracker"
fi

