# # Degen feed v3: Solana early-launch -> degen lane cards.
# # NOTE 2026-10-17: found dead since 2026-10-14 (crashed 7 min after start,
# # no supervisor covered it, degen-health has no cron). Added to watchdog
# # supervision — this is one of the two Solana card feeds the user gambles
# # on; it must not silently die. Standalone, not in forex-daemons.
# if ! pgrep -f "scripts/degen-feed$" > /dev/null 2>&1; then
